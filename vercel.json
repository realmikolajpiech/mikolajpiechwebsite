{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/crawl/portfolio.html",
      "destination": "/portfolio",
      "permanent": true
    },
    {
      "source": "/crawl/portfolio",
      "destination": "/portfolio",
      "permanent": true
    }
  ]
}
