{
  "name": "mikołaj-piech---founder-&-developer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "npm run images:generate",
    "dev": "vite",
    "images:generate": "node scripts/generate-images.mjs",
    "seo:check": "node scripts/check-seo.mjs",
    "og:generate": "node scripts/generate-og-image.mjs",
    "llm:generate": "npm run images:generate && npm run build:ssr && node scripts/generate-llm-assets.mjs",
    "prebuild": "npm run images:generate",
    "build:client": "vite build",
    "build:ssr": "vite build --ssr entry-server.tsx --outDir dist-ssr",
    "build": "npm run build:client && npm run build:ssr && node scripts/generate-llm-assets.mjs && node scripts/prerender.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "framer-motion": "^12.23.26",
    "lucide-react": "^0.562.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vercel/node": "^7.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.27",
    "postcss": "^8.5.8",
    "sharp": "^0.35.2",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
